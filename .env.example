# Copie este archivo como .env para desarrollo local. Nunca suba .env al repositorio.
# Los valores de aquí son solo para desarrollo: producción usa otros, desde el gestor de secretos.

# --- Django ---
# Producción se niega a arrancar con esta clave de ejemplo.
SECRET_KEY=clave-de-ejemplo-solo-para-desarrollo-local-no-usar-en-produccion
# Hosts permitidos, separados por comas. Obligatorio en producción.
ALLOWED_HOSTS=localhost,127.0.0.1
# Solo producción: orígenes con esquema, separados por comas (https://ejemplo.cl). Vacía:
# solo SITIO_URL.
CSRF_TRUSTED_ORIGINS=
# Solo producción: segundos de HSTS. Parte bajo y se sube al confirmar HTTPS.
SECURE_HSTS_SECONDS=3600
# Solo producción: HSTS también para los subdominios y precarga en los navegadores. Son
# difíciles de revertir: actívelos cuando el dominio y sus subdominios sirvan solo HTTPS.
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
# Nivel de los logs: DEBUG, INFO, WARNING o ERROR.
NIVEL_DE_LOG=INFO

# --- Base de datos ---
# PostgreSQL del contenedor "db" de Docker Compose.
POSTGRES_DB=webseba
POSTGRES_USER=webseba
POSTGRES_PASSWORD=solo-desarrollo-local
DATABASE_URL=postgres://webseba:solo-desarrollo-local@db:5432/webseba

# --- Sitio y acceso ---
# URL pública, sin barra final. Con ella se arman los enlaces de activación y de recuperación.
# Obligatoria y con https en producción.
SITIO_URL=http://localhost:8000
# Ruta del admin de Django, solo para el superusuario técnico. Vacía: no se publica.
# En producción use una ruta que no sea fácil de adivinar.
DJANGO_ADMIN_RUTA=admin-tecnico
# Minutos sin uso tras los que vence la sesión.
SESION_MINUTOS_INACTIVIDAD=60

# --- Proxy de confianza ---
# Redes (CIDR, separadas por comas) de los proxies que anteponen la aplicación. Solo de ellos
# se acepta el encabezado con la IP del cliente. Vacía: la aplicación recibe las conexiones
# directamente y no lee ningún encabezado. Producción exige declararla, aunque sea vacía.
PROXY_CONFIANZA_REDES=
PROXY_CONFIANZA_ENCABEZADO=X-Forwarded-For
# Solo producción: encabezado con que el proxy indica que la petición llegó por HTTPS (por
# ejemplo, X-Forwarded-Proto). Obligatorio si hay proxy de confianza; sin proxy va vacío.
# El proxy debe sobrescribirlo siempre, y la aplicación no debe ser alcanzable sin pasar por él.
PROXY_HTTPS_ENCABEZADO=

# --- Bloqueo por intentos fallidos de acceso ---
ACCESO_INTENTOS_MAXIMOS=5
ACCESO_INTENTOS_MAXIMOS_IP=30
ACCESO_VENTANA_MINUTOS=15
ACCESO_BLOQUEO_MINUTOS=15

# --- Enlaces de activación y recuperación ---
ENLACE_ACTIVACION_HORAS=72
ENLACE_RESTABLECIMIENTO_MINUTOS=60
RECUPERACION_MAXIMO_POR_RUT=3
RECUPERACION_MAXIMO_POR_IP=10
# Minutos que tiene un administrador, tras usar un enlace, para configurar su 2FA.
ENROLAMIENTO_2FA_MINUTOS=30

# --- Auditoría ---
# Meses que se conservan los eventos. El comando depurar_auditoria borra los anteriores.
AUDITORIA_RETENCION_MESES=24

# --- Documentos ---
# Dónde se guardan los archivos: "local" (carpeta DOCUMENTOS_DIR, fuera de toda ruta pública)
# o "s3" (bucket privado compatible con S3). Producción exige declararla.
DOCUMENTOS_ALMACENAMIENTO=local
DOCUMENTOS_DIR=/var/app/media
# Solo con "s3". El bucket debe ser privado; las credenciales, con permisos mínimos sobre él.
# S3_ENDPOINT_URL va vacía en AWS y con la URL del proveedor en los demás.
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Extensiones permitidas, separadas por comas, y tamaño máximo por archivo.
DOCUMENTOS_FORMATOS=pdf,docx,xlsx,pptx,jpg,jpeg,png
DOCUMENTOS_TAMANO_MAXIMO_MB=25
# Segundos de vigencia de la URL firmada de descarga (máximo 120).
DESCARGA_URL_SEGUNDOS=120
# Días que un documento eliminado se puede restaurar. El comando purgar_papelera borra los demás.
PAPELERA_DIAS=30

# --- Solicitudes del sitio público ---
# Correos que reciben el aviso de cada consulta o cotización, separados por comas. Vacía: la
# solicitud se guarda igual y su notificación queda como "correo no configurado".
NOTIFICACIONES_DESTINATARIOS=
# Intentos de envío por solicitud antes de que reintentar_notificaciones la deje de lado.
NOTIFICACIONES_INTENTOS_MAXIMOS=5
# Antispam de los formularios: envíos por hora desde una misma IP y segundos mínimos entre
# mostrar el formulario y enviarlo.
SOLICITUDES_MAXIMO_POR_HORA_IP=5
SOLICITUDES_TIEMPO_MINIMO_SEGUNDOS=3
# Punto de extensión para un captcha, desactivado. Ruta de una función de Python que recibe
# la petición y devuelve si el captcha fue resuelto. Vacía: sin captcha.
SOLICITUDES_CAPTCHA=
# Permite cargar_demo: solo en desarrollo y en staging con datos ficticios. Producción no
# define esta variable.
DEMO_PERMITIDO=true

# --- Correo saliente (SMTP) ---
# Sin CORREO_HOST no se envía correo: en desarrollo se imprime en la consola del contenedor
# y en producción los envíos quedan registrados como "correo no configurado".
CORREO_HOST=
CORREO_PUERTO=587
CORREO_USUARIO=
CORREO_CLAVE=
CORREO_TLS=true
# Remitente del dominio propio, por ejemplo "Nombre <no-responder@ejemplo.cl>".
CORREO_REMITENTE=

# --- Avisos al administrador técnico ---
# Correos que reciben el aviso de cada error 500 y de cada tarea programada que falla,
# separados por comas. Vacía: no se avisa. El aviso no lleva datos de formularios.
ERRORES_DESTINATARIOS=
# Tope de avisos de error por hora, por cada proceso del servidor.
ERRORES_AVISOS_POR_HORA=5
