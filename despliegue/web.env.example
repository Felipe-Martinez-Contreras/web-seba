# Variables de la aplicación en el servidor. Copie este archivo a /etc/web-seba/web.env
# (lo hace despliegue/vm/preparar.sh), complete los valores y déjelo con permisos 600.
# Nunca lo suba al repositorio. El significado de cada variable está en .env.example.
# Los valores van sin comillas y sin el signo $ (Docker Compose lo interpreta).

# --- Django ---
# Para generarla: openssl rand -base64 48
SECRET_KEY=
# El nombre público del sitio, sin https:// (por ejemplo, portal.ejemplo.cl).
ALLOWED_HOSTS=
# El mismo nombre, con https:// y sin barra final.
SITIO_URL=
# Una ruta difícil de adivinar para el admin de Django. Para generarla: openssl rand -hex 8
DJANGO_ADMIN_RUTA=
# HSTS parte en una hora. Súbalo a 31536000 cuando el sitio lleve unos días sirviendo por HTTPS.
SECURE_HSTS_SECONDS=3600
NIVEL_DE_LOG=INFO

# --- Base de datos ---
# La misma clave de POSTGRES_PASSWORD, en compose.env.
DATABASE_URL=postgres://webseba:CLAVE-DE-LA-BASE@db:5432/webseba

# --- Proxy de confianza: solo el contenedor del túnel de Cloudflare ---
# No cambie estos tres valores: la dirección es la que fija compose.prod.yaml y Cloudflare
# escribe la IP del visitante en CF-Connecting-IP.
PROXY_CONFIANZA_REDES=172.30.57.2/32
PROXY_CONFIANZA_ENCABEZADO=CF-Connecting-IP
PROXY_HTTPS_ENCABEZADO=X-Forwarded-Proto

# --- Documentos: Google Cloud Storage por su API compatible con S3 ---
DOCUMENTOS_ALMACENAMIENTO=s3
S3_BUCKET=
S3_ENDPOINT_URL=https://storage.googleapis.com
S3_REGION=auto
# Clave HMAC de la cuenta de servicio que solo puede leer, escribir y borrar en ese bucket.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Correo: Resend por SMTP ---
CORREO_HOST=smtp.resend.com
CORREO_PUERTO=587
CORREO_USUARIO=resend
# La API key de Resend, con permiso solo de envío y limitada al dominio.
CORREO_CLAVE=
CORREO_TLS=true
# Una dirección del dominio verificado en Resend, por ejemplo: Portal <no-responder@ejemplo.cl>
CORREO_REMITENTE=

# --- Destinatarios ---
# Quien recibe las consultas y cotizaciones del sitio.
NOTIFICACIONES_DESTINATARIOS=
# Quien recibe los avisos de errores 500 y de tareas programadas que fallan.
ERRORES_DESTINATARIOS=

# --- Opcional: plazo de conservación de consultas y cotizaciones (365 si no se indica) ---
# Es el plazo de la política de privacidad; mínimo 30. La tarea diaria borra las anteriores.
# SOLICITUDES_RETENCION_DIAS=365

# --- Opcional: procesos e hilos de Gunicorn (1 y 4 si no se indican) ---
# GUNICORN_PROCESOS=1
# GUNICORN_HILOS=4
