# Variables de Docker Compose en el servidor. Copie este archivo a /etc/web-seba/compose.env
# (lo hace despliegue/vm/preparar.sh), complete los valores y déjelo con permisos 600.
# Nunca lo suba al repositorio.

# Commit desplegado (40 caracteres). Lo escribe despliegue/vm/desplegar.sh; no lo edite a mano.
WEB_SEBA_VERSION=

# Base de datos del contenedor "db". La clave: 32 caracteres o más, solo letras y números
# (va también dentro de DATABASE_URL, en web.env). Para generarla: openssl rand -hex 24
POSTGRES_DB=webseba
POSTGRES_USER=webseba
POSTGRES_PASSWORD=

# Token del túnel de Cloudflare (Zero Trust › Redes › Túneles). Quien lo tenga puede recibir
# el tráfico del sitio: trátelo como una contraseña.
TUNNEL_TOKEN=

# Bucket de respaldos, sin gs://. Lo usa despliegue/vm/respaldar.sh.
RESPALDOS_BUCKET=
